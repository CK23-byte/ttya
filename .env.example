# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_api_key_here

# D-ID API Configuration (for video avatars)
# Get your API key from: https://studio.d-id.com/
# Note: Use DID_API_KEY (without VITE_ prefix) in Vercel environment variables
DID_API_KEY=your_did_api_key_here

# ElevenLabs API Configuration (for voice cloning)
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Configuration (for conversational AI)
# Get your API key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
# Get your credentials from: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# HeyGen API Configuration (Legacy - Being Phased Out)
# Get your API key from: https://app.heygen.com/
HEYGEN_API_KEY=your_heygen_api_key_here
VITE_HEYGEN_AVATAR_ID=default_avatar_id_here

# Tavus API Configuration (NEW - Scalable Real-Time Video Avatars)
# Get your API key from: https://tavus.io/dashboard/api-keys
# Sign up at: https://tavus.io (Recommended: Hobbyist plan $39/mo for testing)
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_WEBHOOK_SECRET=your_tavus_webhook_secret_here

# WebRTC Server Configuration (for real-time avatar conversations)
# Local development: http://localhost:3001
# Production: Deploy server/ directory separately and set the URL here
VITE_WEBRTC_SERVER_URL=http://localhost:3001

# Stripe Configuration (for payments)
# Get your keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Security Configuration
VITE_ENCRYPTION_ITERATIONS=100000
VITE_SESSION_TIMEOUT_MINUTES=30
